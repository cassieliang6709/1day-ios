        "error_code": {
          "type": "string",
          "enum": [
            "network_unavailable",
            "permission_denied",
            "disk_full",
            "upstream_timeout",
            "rate_limited",
            "malformed_response",
            "asset_unavailable",
            "unknown"
          ]
        }
      },
      "required": [
        "story_id",
        "operation_id",
        "result",
        "duration_ms"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "failure"
              }
            }
          },
          "then": {
            "required": [
