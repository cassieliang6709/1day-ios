      "properties": {
        "story_id": {
          "$ref": "#/$defs/uuid"
        },
        "render_operation_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "story_id",
        "render_operation_id"
      ]
    },
    "ai_suggestion_requested": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
