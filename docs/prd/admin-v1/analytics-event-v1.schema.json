          ]
        },
        "error_code": {
          "type": "string",
          "enum": [
            "network_unavailable",
            "permission_denied",
            "disk_full",
            "upstream_timeout",
            "rate_limited",
            "malformed_response",
            "asset_unavailable",
            "unknown"
          ]
        }
      },
      "required": [
        "operation_id",
        "room_analytics_id",
        "result"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "failure"
              }
            }
          },
          "then": {
            "required": [
              "error_code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "success"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "error_code"
              ]
            }
          }
        }
      ]
    },
    "film_render_started": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "story_id": {
          "$ref": "#/$defs/uuid"
        },
        "operation_id": {
          "$ref": "#/$defs/uuid"
        },
        "clip_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "layout": {
          "type": "string",
          "enum": [
            "sequential",
            "friends_together"
          ]
        }
      },
      "required": [
        "story_id",
        "operation_id",
        "clip_count",
        "layout"
      ]
    },
