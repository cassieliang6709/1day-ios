          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "room_analytics_id",
        "story_id"
      ]
    },
    "room_join_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/uuid"
        },
        "room_analytics_id": {
          "$ref": "#/$defs/uuid"
        },
        "result": {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "cancelled"
          ]
        },
        "error_code": {
          "type": "string",
          "enum": [
            "network_unavailable",
            "permission_denied",
            "disk_full",
            "upstream_timeout",
            "rate_limited",
            "malformed_response",
            "asset_unavailable",
            "unknown"
          ]
        }
      },
      "required": [
        "operation_id",
        "result"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "failure"
              }
            }
          },
          "then": {
            "required": [
              "error_code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "success"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "error_code"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "success"
              }
            }
          },
          "then": {
            "required": [
              "room_analytics_id"
            ]
          }
        }
      ]
    },
    "room_clip_sync_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/uuid"
        },
        "room_analytics_id": {
          "$ref": "#/$defs/uuid"
        },
        "result": {
          "type": "string",
          "enum": [
            "success",
            "failure",
